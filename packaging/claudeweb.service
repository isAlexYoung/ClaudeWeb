[Unit]
Description=ClaudeWeb, a web interface for Claude Code
Documentation=https://github.com/isAlexYoung/ClaudeWeb
# The server binds loopback and must start even when the provider's network
# manager never satisfies systemd-networkd-wait-online.
After=network.target

[Service]
Type=simple
User=claudeweb
Group=claudeweb
WorkingDirectory=/home/claudeweb
# HOST, SERVER_PORT, DATABASE_PATH and the other settings; written by install.sh.
EnvironmentFile=/etc/claudeweb/claudeweb.env
Environment=HOME=/home/claudeweb USER=claudeweb LOGNAME=claudeweb SHELL=/bin/bash
Environment=LANG=C.UTF-8 LC_ALL=C.UTF-8 NODE_ENV=production
# npm and the processes ClaudeWeb starts use the bundled Node; TaskMaster's CLI is on PATH.
Environment=PATH=/opt/claudeweb/current/node/bin:/opt/claudeweb/current/app/tools/taskmaster/node_modules/.bin:/home/claudeweb/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=npm_config_include=dev
ExecStart=/opt/claudeweb/current/node/bin/node /opt/claudeweb/current/app/dist-server/server/index.js
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=15
# No memory, CPU or task quotas: ClaudeWeb uses what the server has, including
# memory added later. A process killed for lack of memory must not stop the
# service (OOMPolicy). Out of memory, Linux ends ClaudeWeb's children first:
# the service scores a little lower than other programs, and the app raises
# everything it starts to 500 (modules/oom-priority); sshd is not outranked.
OOMPolicy=continue
OOMScoreAdjust=-100
TasksMax=infinity
LimitNOFILE=65536
UMask=0007

[Install]
WantedBy=multi-user.target
