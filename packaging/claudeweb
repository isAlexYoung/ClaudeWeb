installed_version() { [[ -f "$CURRENT/VERSION" ]] && cat "$CURRENT/VERSION" || echo "not installed"; }
node_bin() { echo "$CURRENT/node/bin/node"; }

# ------------------------------------------------------------------ status
cmd_status() {
  need_root status
  echo "ClaudeWeb $(installed_version) ($(sed -n 's/.*"channel": "\(.*\)".*/\1/p' "$CURRENT/release.json" 2>/dev/null || echo unknown))"
  echo "Service:   $(systemctl is-active "$SERVICE" 2>/dev/null || true) ($(systemctl is-enabled "$SERVICE" 2>/dev/null || echo not installed))"
  if curl -fsS -m 5 "http://127.0.0.1:$PORT/api/auth/status" >/dev/null 2>&1; then
    echo "Address:   http://127.0.0.1:$PORT (answering)"
  else
    echo "Address:   http://127.0.0.1:$PORT (not answering)"
  fi
  if [[ -f $DOMAIN_STATE ]]; then domain_status; else echo "Domain:    none (set one up with: claudeweb domain)"; fi
  echo "Password:  $([[ -f $ETC_DIR/login.json ]] && echo set || echo 'not set (claudeweb password --set)')"
  local claude="$SERVICE_HOME/.local/bin/claude"
  if [[ -x $claude ]]; then
    echo "Claude CLI: $(as_service "$claude" --version 2>/dev/null | head -n1 || echo 'installed, version unknown')"
  else
    echo "Claude CLI: not installed"
  fi
  echo "Swap:      $(swap_summary)"
  echo "Disk:      $(df -h --output=avail "$SERVICE_HOME" 2>/dev/null | tail -n1 | tr -d ' ') free in $SERVICE_HOME"
}

# ------------------------------------------------------------------ logs
cmd_logs() {
  need_root logs
  if [[ ${1:-} == --follow ]]; then
    exec journalctl -u "$SERVICE" -n 100 -f --no-pager
  fi
  [[ $# -eq 0 ]] || die "usage: claudeweb logs [--follow]"
  journalctl -u "$SERVICE" -n 200 --no-pager
}

# ------------------------------------------------------------------ doctor
cmd_doctor() {
  need_root doctor
  # Only facts about the machine and the service: never the password files,
  # the database, Claude's credentials or the browser profile.
  echo "== ClaudeWeb doctor report ($(date -u +%Y-%m-%dT%H:%M:%SZ))"
  echo "Version:   $(installed_version)"
  [[ -f $CURRENT/release.json ]] && cat "$CURRENT/release.json" && echo
  echo "== System"
  grep -E '^(PRETTY_NAME|VERSION_ID)=' /etc/os-release || true
  echo "Kernel:    $(uname -r) $(uname -m)"
  echo "Virt:      $(systemd-detect-virt 2>/dev/null || echo unknown)"
  echo "CPUs:      $(nproc)"
  free -h
  echo "Swap:      $(swap_summary)"
  df -h / "$SERVICE_HOME" "$OPT_DIR" 2>/dev/null || true
  echo "IPv6:      $(sysctl -n net.ipv6.conf.all.disable_ipv6 2>/dev/null | sed 's/1/disabled/;s/0/enabled/')"
  echo "== Service"
  systemctl status "$SERVICE" --no-pager -l 2>&1 | head -n 15 || true
  ss -ltnp "sport = :$PORT" 2>/dev/null || true
  echo "== Files"
  ls -ld "$OPT_DIR" "$CURRENT" "$ETC_DIR" "$DATA_DIR" "$SERVICE_HOME" 2>&1 || true
  ls -l "$ETC_DIR" 2>&1 || true
  echo "== Settings ($ENV_FILE)"
  cat "$ENV_FILE" 2>/dev/null || echo "missing"
  echo "== Claude CLI"
  if [[ -x $SERVICE_HOME/.local/bin/claude ]]; then
    as_service "$SERVICE_HOME/.local/bin/claude" --version 2>&1 | head -n1 || true
  else
    echo "not installed"
  fi
  echo "== Last 80 log lines"
  journalctl -u "$SERVICE" -n 80 --no-pager 2>&1 || true
}

# ------------------------------------------------------------------ password
cmd_password() {
  need_root password
  [[ -x $(node_bin) ]] || die "ClaudeWeb is not installed"
  local env_args=()
  if [[ -f $ENV_FILE ]]; then
    while IFS= read -r line; do
      [[ $line =~ ^[A-Z_][A-Z0-9_]*= ]] && env_args+=("$line")
    done < "$ENV_FILE"
  fi
  # As root: the password copy is root's alone, and new files in /etc/claudeweb
  # take the directory's group so the service can read login.json.
  env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 HOME=/root "${env_args[@]}" \
    "$(node_bin)" "$CURRENT/app/dist-server/server/modules/cli/cli.js" password "$@"
}

# ------------------------------------------------------------------ sudo password
# The claudeweb user is in the sudo group with a password, never without one.
# Claude's sudo asks the user in ClaudeWeb, who types this password there; it
# then goes to sudo for that one command. Root keeps the only copy.
cmd_sudo_password() {
  need_root sudo-password
  id -u "$SERVICE_USER" >/dev/null 2>&1 || die "ClaudeWeb is not installed"
  case "${1:-}" in
    "")
      [[ -f $SUDO_PASSWORD_FILE ]] || die "no sudo password is set; set one with: claudeweb sudo-password --set"
      cat "$SUDO_PASSWORD_FILE"
      ;;
    --set)
      local password generated=yes
      if [[ ${2:-} == --stdin ]]; then
        generated=no
        if [[ -t 0 ]]; then read -r -s -p "New sudo password for $SERVICE_USER: " password; echo >&2; else IFS= read -r password; fi
        (( ${#password} >= 8 )) || die "use at least 8 characters"
      else
        password="$(head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9')"
        password="${password:0:20}"
      fi
      [[ $password != *:* ]] || die "the password cannot contain ':'"
      printf '%s:%s\n' "$SERVICE_USER" "$password" | chpasswd
      install -m 0600 -o root -g root /dev/null "$SUDO_PASSWORD_FILE"
      printf '%s\n' "$password" > "$SUDO_PASSWORD_FILE"
      # A new group is seen by processes started after this; install.sh restarts the service.
      usermod -aG sudo "$SERVICE_USER"
      if [[ -d $(dirname "$SSHD_DROPIN") && ! -f $SSHD_DROPIN ]]; then
        # A plain DenyUsers line: a Match block here could take in the main file's later settings.
        printf '# ClaudeWeb: the claudeweb user has a password only for sudo; it never logs in over SSH.\nDenyUsers %s\n' \
          "$SERVICE_USER" > "$SSHD_DROPIN"
        chmod 0644 "$SSHD_DROPIN"
        systemctl reload ssh >/dev/null 2>&1 || true
      fi
      if [[ $generated == yes ]]; then echo "New sudo password for $SERVICE_USER: $password"; else echo "sudo password changed"; fi
      ;;
    *) die "usage: claudeweb sudo-password [--set [--stdin]]" ;;
  esac
}

# ------------------------------------------------------------------ swap
ram_mib() { awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo; }
swap_summary() {
  local total
  total="$(awk '/^SwapTotal:/ {print int($2/1024)}' /proc/meminfo)"
  if [[ $total -eq 0 ]]; then echo "none"; return; fi
  echo "${total} MiB$( [[ -f $SWAP_FILE ]] && echo " (ClaudeWeb's $SWAP_FILE: $(( $(stat -c %s "$SWAP_FILE") / 1048576 )) MiB)")"
}

swap_remove() {
  if [[ -f $SWAP_FILE ]]; then
    swapoff "$SWAP_FILE" 2>/dev/null || true
    rm -f "$SWAP_FILE"
  fi
  sed -i "\|^$SWAP_FILE |d" /etc/fstab
}

swap_create() {
  local size_mib=$1
  local free_mib
  free_mib="$(df --output=avail -m / | tail -n1 | tr -d ' ')"
  # Keep at least 5 GiB free for projects and updates after the swap file.
  if (( free_mib - size_mib < 5120 )); then
    die "not enough disk for ${size_mib} MiB of swap (${free_mib} MiB free, 5 GiB must stay free)"
  fi
  if systemd-detect-virt --container >/dev/null 2>&1; then
    die "this is a container; its swap is managed by the host"
  fi
  swap_remove
  fallocate -l "${size_mib}M" "$SWAP_FILE" 2>/dev/null || dd if=/dev/zero of="$SWAP_FILE" bs=1M count="$size_mib" status=none
  chmod 0600 "$SWAP_FILE"
  mkswap -q "$SWAP_FILE"
  swapon "$SWAP_FILE"
  echo "$SWAP_FILE none swap sw 0 0" >> /etc/fstab
  echo "Swap file $SWAP_FILE: ${size_mib} MiB"
}

cmd_swap() {
  need_root swap
  case "${1:-}" in
    "") echo "Swap: $(swap_summary)"; swapon --show 2>/dev/null || true ;;
    --size=*)
      local size="${1#--size=}"
      [[ $size =~ ^([1-9]|1[0-6])G$ ]] || die "use --size=<1-16>G"
      swap_create $(( ${size%G} * 1024 )) ;;
    --auto)
      # Only when the machine has no swap at all; existing swap is left alone.
      if [[ "$(awk '/^SwapTotal:/ {print $2}' /proc/meminfo)" -gt 0 ]]; then
        echo "Swap already present: $(swap_summary)"; return 0
      fi
      if systemd-detect-virt --container >/dev/null 2>&1; then
        echo "Container: swap is managed by the host, skipped"; return 0
      fi
      # As much as the memory, at least 2 GiB and at most 4 GiB.
      local size_mib
      size_mib="$(ram_mib)"
      (( size_mib < 2048 )) && size_mib=2048
      (( size_mib > 4096 )) && size_mib=4096
      swap_create "$size_mib" ;;
    --off) swap_remove; echo "ClaudeWeb's swap file removed. Swap now: $(swap_summary)" ;;
    *) die "usage: claudeweb swap [--size=<N>G | --auto | --off]" ;;
  esac
}

# ------------------------------------------------------------------ update
releases_url() {
  local url=""
  [[ -f $UPDATE_CONF ]] && url="$(sed -n 's/^RELEASES_URL=//p' "$UPDATE_CONF" | tail -n1)"
  echo "${url:-$DEFAULT_RELEASES_URL}"
}

# Downloads the release list into $1 and checks its signature. Nothing in it
# is used unless the signature checks out under RELEASE_PUBKEY.
fetch_release_list() {
  local work=$1 base
  base="$(releases_url)"
  curl -fsSL --retry 3 -m 60 -o "$work/releases.json" "$base/releases.json" \
    && curl -fsSL --retry 3 -m 60 -o "$work/releases.json.minisig" "$base/releases.json.minisig" \
    || { echo "cannot download the release list from $base" >&2; return 1; }
  cw_minisign -Vq -P "$RELEASE_PUBKEY" -m "$work/releases.json" -x "$work/releases.json.minisig" >/dev/null 2>&1 \
    || { echo "the release list signature is not valid" >&2; return 1; }
  jq -e '.schema == 1 and (.releases | type == "array")' "$work/releases.json" >/dev/null 2>&1 \
    || { echo "the release list is malformed" >&2; return 1; }
}

# Stable releases newer than $2, newest first, from the verified list in $1.
newer_stable() {
  jq -c --arg current "$2" '
    def v: split(".") | map(tonumber);
    [.releases[] | select(.channel == "stable" and ((.version | v) > ($current | v)))]
    | sort_by(.version | v) | reverse' "$1"
}

# Progress for Settings > About, which polls this file (readable by everyone; no secrets).
write_status() {  # write_status <state> <version> [error code]
  install -d -m 0755 "$STATUS_DIR"
  printf '{"state": "%s", "version": "%s", "installed": "%s", "error": %s, "updated_at": %s}\n' \
    "$1" "$2" "$(installed_version)" "$( [[ -n ${3:-} ]] && printf '"%s"' "$3" || echo null)" "$(date +%s)" > "$STATUS_FILE.new"
  chmod 0644 "$STATUS_FILE.new"
  mv -f "$STATUS_FILE.new" "$STATUS_FILE"
}

UPDATE_TARGET=""
update_failed() {  # update_failed <code> <message>
  write_status failed "$UPDATE_TARGET" "$1"
  die "$2"
}

health_ok() {
  local _
  for _ in $(seq 1 "${1:-120}"); do
    curl -fsS -m 3 "http://127.0.0.1:$PORT/api/auth/status" >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}

record_install() {  # record_install <version> <previous version or empty>
  printf '{\n "version": "%s",\n "previous": %s,\n "updated_at": "%s"\n}\n' "$1" \
    "$( [[ -n $2 ]] && printf '"%s"' "$2" || echo null)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$INSTALL_RECORD.new"
  chmod 0644 "$INSTALL_RECORD.new"
  mv -f "$INSTALL_RECORD.new" "$INSTALL_RECORD"
}

# Points `current` at a release, installs that release's units and starts it.
switch_to() {
  local version=$1 unit
  [[ -d $RELEASES/$version ]] || die "release $version is not on this server"
  systemctl stop "$SERVICE" 2>/dev/null || true
  ln -sfn "$RELEASES/$version" "$CURRENT.new"
  mv -Tf "$CURRENT.new" "$CURRENT"
  for unit in claudeweb.service claudeweb-update.socket claudeweb-update@.service; do
    [[ -f $RELEASES/$version/share/$unit ]] && install -m 0644 "$RELEASES/$version/share/$unit" "/etc/systemd/system/$unit"
  done
  # The domain's tunnel unit, only where a domain is set up; cloudflared keeps running.
  if [[ -f $DOMAIN_STATE && -f $RELEASES/$version/share/claudeweb-tunnel.service ]]; then
    install -m 0644 "$RELEASES/$version/share/claudeweb-tunnel.service" "$TUNNEL_UNIT"
  fi
  systemctl daemon-reload
  systemctl start "$SERVICE"
}

backup_database() {  # copies auth.db while the service is stopped; never restored automatically
  local from=$1 target file
  target="$UPDATE_DIR/backups/$from-$(date -u +%Y%m%dT%H%M%SZ)"
  install -d -m 0700 "$target"
  for file in "$DATA_DIR"/auth.db "$DATA_DIR"/auth.db-wal "$DATA_DIR"/auth.db-shm; do
    [[ -f $file ]] && cp -p "$file" "$target/"
  done
  { ls -1dt "$UPDATE_DIR/backups"/*/ 2>/dev/null | tail -n +$((KEEP_BACKUPS + 1)) | xargs -r rm -rf; } || true
  echo "$target"
}

prune_releases() {  # keeps the newest few, and always the current and previous ones
  local keep_a=$1 keep_b=$2 dir name count=0
  while IFS= read -r dir; do
    name="$(basename "$dir")"
    count=$((count + 1))
    if (( count > KEEP_RELEASES )) && [[ $name != "$keep_a" && $name != "$keep_b" ]]; then rm -rf "$dir"; fi
  done < <(ls -1d "$RELEASES"/*/ 2>/dev/null | sed 's:/$::' | sort -t/ -k5 -V -r)
}

cmd_update() {
  need_root update
  cw_platform_detect || die "this server's platform is not supported"
  local wanted="" check_only=0 argument
  for argument in "$@"; do
    case "$argument" in
      --check) check_only=1 ;;
      --version=*) wanted="${argument#--version=}" ;;
      *) die "usage: claudeweb update [--check | --version=X.Y.Z]" ;;
    esac
  done
  exec 9>"$UPDATE_LOCK"
  flock -n 9 || die "another update or rollback is running"
  if [[ -f $UPDATE_STATE ]]; then
    UPDATE_TARGET="$(jq -r '.to // empty' "$UPDATE_STATE" 2>/dev/null)"
    update_failed CLAUDEWEB_UPDATE_RUNNING \
      "an earlier update did not finish ($(jq -r '"\(.from) -> \(.to), \(.phase)"' "$UPDATE_STATE" 2>/dev/null)); run: claudeweb rollback"
  fi

  local current work target entry
  current="$(installed_version)"
  UPDATE_TARGET="$wanted"
  (( check_only )) || write_status checking "$wanted"
  work="$(mktemp -d)"
  trap "rm -rf '$work'" EXIT   # expanded now: $work is local and gone by exit time
  fetch_release_list "$work" || update_failed CLAUDEWEB_CATALOGUE_UNAVAILABLE "the release list could not be used; nothing was changed"
  if [[ -n $wanted ]]; then
    entry="$(jq -c --arg v "$wanted" '.releases[] | select(.version == $v)' "$work/releases.json")"
    [[ -n $entry ]] || update_failed CLAUDEWEB_VERSION_UNKNOWN "release $wanted is not in the release list"
  else
    entry="$(newer_stable "$work/releases.json" "$current" | jq -c '.[0] // empty')"
    if [[ -z $entry ]]; then
      (( check_only )) || write_status idle "$current"
      echo "ClaudeWeb $current is up to date."
      return 0
    fi
  fi
  target="$(jq -r .version <<<"$entry")"
  UPDATE_TARGET="$target"
  if [[ $target == "$current" ]]; then
    (( check_only )) || write_status idle "$current"
    echo "ClaudeWeb $current is installed; nothing to do."
    return 0
  fi
  if (( check_only )); then
    echo "ClaudeWeb $target is available ($(jq -r .channel <<<"$entry")); installed: $current. Update with: claudeweb update"
    return 0
  fi

  echo "Updating ClaudeWeb $current -> $target"
  local url bytes sha free_mib
  url="$(jq -r .package.url <<<"$entry")"; bytes="$(jq -r .package.bytes <<<"$entry")"; sha="$(jq -r .package.sha256 <<<"$entry")"
  free_mib="$(df --output=avail -m "$OPT_DIR" | tail -n1 | tr -d ' ')"
  (( free_mib > bytes / 1048576 * 8 + 1024 )) || update_failed CLAUDEWEB_DISK_REQUIRED "not enough free disk space for the update (${free_mib} MiB free)"
  if [[ ! -d $RELEASES/$target ]]; then
    write_status downloading "$target"
    curl -fsSL --retry 3 -o "$work/package.tar.xz" "$url" || update_failed CLAUDEWEB_DOWNLOAD_FAILED "cannot download $url"
    [[ "$(stat -c %s "$work/package.tar.xz")" == "$bytes" ]] \
      || update_failed CLAUDEWEB_DOWNLOAD_FAILED "the downloaded package has the wrong size; nothing was changed"
    [[ "$(sha256sum "$work/package.tar.xz" | cut -d' ' -f1)" == "$sha" ]] \
      || update_failed CLAUDEWEB_DOWNLOAD_FAILED "the downloaded package does not match the release list; nothing was changed"
    write_status installing "$target"
    tar -xJf "$work/package.tar.xz" -C "$work"
    [[ "$(cat "$work/claudeweb-$target/VERSION" 2>/dev/null)" == "$target" ]] \
      || update_failed CLAUDEWEB_DOWNLOAD_FAILED "the package does not contain ClaudeWeb $target"
    cw_check_release_platform "$work/claudeweb-$target" \
      || update_failed CLAUDEWEB_PLATFORM_INCOMPATIBLE "the new package cannot run on this server; the current version is still running"
    chown -R root:root "$work/claudeweb-$target"
    rm -rf "$RELEASES/$target.partial"
    mv "$work/claudeweb-$target" "$RELEASES/$target.partial"
    mv "$RELEASES/$target.partial" "$RELEASES/$target"
  fi
  cw_check_release_platform "$RELEASES/$target" \
    || update_failed CLAUDEWEB_PLATFORM_INCOMPATIBLE "the target package cannot run on this server; the current version is still running"
  # A new release may pin a newer Chromium; without it only the browser panel is missing.
  if [[ -f $RELEASES/$target/share/playwright-version ]] \
    && ! cmp -s "$RELEASES/$target/share/playwright-version" "$CURRENT/share/playwright-version" 2>/dev/null; then
    "$RELEASES/$target/bin/claudeweb" install-browser "$RELEASES/$target" \
      || echo "warning: the browser for $target could not be installed; run: claudeweb install-browser" >&2
  fi

  if [[ ! -x /usr/bin/claude-desktop ]]; then
    "$RELEASES/$target/bin/claudeweb" install-desktop \
      || echo "warning: ClaudeDesktop is unavailable; run: claudeweb install-desktop" >&2
  fi

  install -d -m 0700 "$UPDATE_DIR"
  printf '{"from": "%s", "to": "%s", "phase": "switching", "started_at": "%s"}\n' "$current" "$target" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$UPDATE_STATE"
  write_status restarting "$target"
  systemctl stop "$SERVICE" 2>/dev/null || true
  local backup
  backup="$(backup_database "$current")"
  echo "Database copied to $backup"
  switch_to "$target"
  if health_ok 120; then
    record_install "$target" "$current"
    rm -f "$UPDATE_STATE"
    prune_releases "$target" "$current"
    write_status done "$target"
    echo "ClaudeWeb $target is running. Return to $current with: claudeweb rollback"
    return 0
  fi
  echo "ClaudeWeb $target did not start; returning to $current." >&2
  switch_to "$current"
  if health_ok 120; then
    rm -f "$UPDATE_STATE"
    update_failed CLAUDEWEB_START_FAILED_ROLLED_BACK "the update failed and ClaudeWeb $current is running again (see: claudeweb logs)"
  fi
  update_failed CLAUDEWEB_START_FAILED "ClaudeWeb $current did not start either; see claudeweb logs, then run claudeweb rollback"
}

cmd_rollback() {
  need_root rollback
  [[ $# -eq 0 ]] || die "usage: claudeweb rollback"
  exec 9>"$UPDATE_LOCK"
  flock -n 9 || die "another update or rollback is running"
  local current previous=""
  current="$(installed_version)"
  # An unfinished update knows where it came from; otherwise install.json does.
  if [[ -f $UPDATE_STATE ]]; then
    previous="$(jq -r '.from // empty' "$UPDATE_STATE" 2>/dev/null)"
  fi
  [[ -n $previous ]] || previous="$(jq -r '.previous // empty' "$INSTALL_RECORD" 2>/dev/null)"
  if [[ -z $previous || $previous == "$current" ]]; then
    if [[ -f $UPDATE_STATE ]]; then
      # The update never left this version: only restart it and clear the state.
      switch_to "$current"
      health_ok 120 || die "ClaudeWeb $current did not start; see: claudeweb logs"
      rm -f "$UPDATE_STATE"
      write_status idle "$current"
      echo "The unfinished update was cleared; ClaudeWeb $current is running."
      return 0
    fi
    die "there is no previous version to return to"
  fi
  [[ -d $RELEASES/$previous ]] || die "release $previous is no longer on this server"
  echo "Returning ClaudeWeb $current -> $previous (user data is kept as it is)"
  switch_to "$previous"
  health_ok 120 || die "ClaudeWeb $previous did not start; see: claudeweb logs"
  record_install "$previous" "$current"
  rm -f "$UPDATE_STATE"
  write_status idle "$previous"
  echo "ClaudeWeb $previous is running."
}

# Answers one request from ClaudeWeb (Settings > About) on the root-owned
# socket claudeweb-update.socket, which only root and the claudeweb group can
# open. Only two requests exist: "check" and "update" to a stable release
# newer than the installed one. The update itself runs as its own job.
cmd_serve_update() {
  [[ $EUID -eq 0 ]] || die "serve-update runs as root from claudeweb-update.socket"
  reply() { printf '%s\n' "$1"; }
  local line op version work current newer
  IFS= read -r -t 10 -n 4096 line || { reply '{"ok": false, "error": "CLAUDEWEB_BAD_REQUEST"}'; return 0; }
  op="$(jq -r 'if type == "object" then .op // empty else empty end' <<<"$line" 2>/dev/null || true)"
  current="$(installed_version)"
  work="$(mktemp -d)"
  trap "rm -rf '$work'" EXIT
  case "$op" in
    check)
      fetch_release_list "$work" 2>/dev/null || { reply '{"ok": false, "error": "CLAUDEWEB_CATALOGUE_UNAVAILABLE"}'; return 0; }
      newer="$(newer_stable "$work/releases.json" "$current")"
      jq -cn --arg installed "$current" --argjson newer "$newer" '{
        ok: true, installed: $installed, latest: ($newer[0].version // $installed),
        newer: [$newer[] | {version, notes: (.notes // ""), compatible: true, download_bytes: .package.bytes}]
      }'
      ;;
    update)
      version="$(jq -r '.version // empty' <<<"$line")"
      [[ $version =~ ^(0|[1-9][0-9]{0,3})\.(0|[1-9][0-9]{0,3})\.(0|[1-9][0-9]{0,3})$ ]] \
        || { reply '{"ok": false, "error": "CLAUDEWEB_VERSION_INVALID"}'; return 0; }
      if [[ -f $UPDATE_STATE ]] || ! flock -n "$UPDATE_LOCK" true; then
        reply '{"ok": false, "error": "CLAUDEWEB_UPDATE_RUNNING"}'; return 0
      fi
      fetch_release_list "$work" 2>/dev/null || { reply '{"ok": false, "error": "CLAUDEWEB_CATALOGUE_UNAVAILABLE"}'; return 0; }
      if ! newer_stable "$work/releases.json" "$current" | jq -e --arg v "$version" 'any(.[]; .version == $v)' >/dev/null; then
        reply '{"ok": false, "error": "CLAUDEWEB_NOT_NEWER"}'; return 0
      fi
      write_status queued "$version"
      systemd-run --quiet --collect --no-block --unit="claudeweb-update-job-$(date +%s)" \
        "$CURRENT/bin/claudeweb" update --version="$version" >/dev/null 2>&1 \
        || { write_status failed "$version" CLAUDEWEB_UPDATE_FAILED; reply '{"ok": false, "error": "CLAUDEWEB_UPDATE_FAILED"}'; return 0; }
      reply '{"ok": true}'
      ;;
    *) reply '{"ok": false, "error": "CLAUDEWEB_BAD_REQUEST"}' ;;
  esac
}

# ------------------------------------------------------------------ browser
# Installs the built-in browser for a release: the system libraries Chromium
# needs (Playwright knows the list for this distribution), then Playwright's
# Chromium into the service account's cache. Used by install.sh and update.
# A command run as the service user starts in its home: root's working
# directory (often /root) is closed to it, and npm then cannot even start sh.
as_service() { (cd "$SERVICE_HOME" && runuser -u "$SERVICE_USER" -- "$@"); }

cmd_install_browser() {
  need_root install-browser
  cw_install_dependencies gui || die "browser display dependencies could not be installed"
  local release="${1:-$CURRENT}" version node_dir
  [[ -f $release/share/playwright-version ]] || die "this release does not name a Playwright version"
  version="$(tr -d '[:space:]' < "$release/share/playwright-version")"
  [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "unexpected Playwright version: $version"
  node_dir="$release/node/bin"
  echo "Installing the browser (Playwright $version)"
  env -i PATH="$node_dir:/usr/sbin:/usr/bin:/sbin:/bin" HOME=/root LANG=C.UTF-8 DEBIAN_FRONTEND=noninteractive \
    "$node_dir/npx" --yes "playwright@$version" install-deps chromium
  as_service env -i PATH="$node_dir:/usr/bin:/bin" HOME="$SERVICE_HOME" LANG=C.UTF-8 \
    "$node_dir/npx" --yes "playwright@$version" install chromium
}

# Installs the official APT package; no third-party Electron repack and no sandbox bypass.
cmd_install_desktop() (
  need_root install-desktop
  local work key source fingerprint
  work="$(mktemp -d)"
  trap 'rm -rf -- "$work"' EXIT
  cw_install_dependencies desktop || die "ClaudeDesktop dependencies could not be installed"
  if [[ $(dpkg-query -W -f='${Status}' claude-desktop 2>/dev/null || true) == 'install ok installed' ]]; then
    echo 'ClaudeDesktop is already installed; its profile and package version were kept.'
    exit 0
  fi
  curl -fsSL --retry 3 -o "$work/key.asc" https://downloads.claude.ai/claude-desktop/key.asc
  fingerprint="$(gpg --no-options --homedir "$work" --batch --with-colons --show-keys "$work/key.asc" \
    | awk -F: '$1=="pub" { primary=1; next } primary && $1=="fpr" { print $10; primary=0 }')"
  [[ $fingerprint == 31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE ]] || die 'ClaudeDesktop signing key does not match'
  key=/usr/share/keyrings/claude-desktop-archive-keyring.asc
  source=/etc/apt/sources.list.d/claude-desktop.list
  [[ ! -L /usr/share/keyrings && ! -L /etc/apt/sources.list.d && ! -L $key && ! -L $source ]] \
    || die 'ClaudeDesktop APT configuration contains a link; review it first'
  mkdir -p -m 0755 /usr/share/keyrings /etc/apt/sources.list.d
  printf 'deb [signed-by=%s] https://downloads.claude.ai/claude-desktop/apt/stable stable main\n' "$key" > "$work/claude.list"
  [[ ! -e $key ]] || cmp -s "$key" "$work/key.asc" || die 'Existing ClaudeDesktop key differs; nothing was replaced'
  [[ ! -e $source ]] || cmp -s "$source" "$work/claude.list" || die 'Existing ClaudeDesktop source differs; nothing was replaced'
  [[ -e $key ]] || install -m 0644 "$work/key.asc" "$key"
  [[ -e $source ]] || install -m 0644 "$work/claude.list" "$source"
  apt-get -o DPkg::Lock::Timeout=180 update
  apt-get -o DPkg::Lock::Timeout=180 install -y --no-install-recommends claude-desktop
  echo 'ClaudeDesktop is installed. Open it with the asterisk in ClaudeWeb.'
)

# ------------------------------------------------------------------ domain
# A domain reaches ClaudeWeb through a Cloudflare Tunnel run by cloudflared on
# this server: no inbound port is opened. The account API token is typed by root,
# used only inside this process for the Cloudflare calls, and never stored; what
# stays on the server is the tunnel's own run token (root only, 0600).
domain_tty() { [[ -r /dev/tty ]] && { : </dev/tty; } 2>/dev/null; }
ask() {  # ask <prompt>: one line from the terminal
  local answer=""
  IFS= read -r -p "$1" answer </dev/tty || return 1
  printf '%s' "$answer"
}
ask_secret() {
  local answer=""
  IFS= read -rs -p "$1" answer </dev/tty || return 1
  echo >&2
  printf '%s' "$answer"
}
ask_yes() {  # ask_yes <prompt> <default y|n>
  local answer
  answer="$(ask "$1")" || return 1
  answer="${answer:-$2}"
  [[ $answer == y || $answer == Y ]]
}

domain_get() { jq -r --arg k "$1" '.[$k] // empty' "$DOMAIN_STATE" 2>/dev/null; }
domain_set() {  # domain_set key value [key value ...]
  local file="$DOMAIN_STATE.new" current='{}'
  [[ -f $DOMAIN_STATE ]] && current="$(cat "$DOMAIN_STATE")"
  while (( $# >= 2 )); do
    current="$(jq --arg k "$1" --arg v "$2" '.[$k] = $v' <<<"$current")"
    shift 2
  done
  (umask 077; printf '%s\n' "$current" > "$file")
  mv -f "$file" "$DOMAIN_STATE"
}

cf_api() {  # cf_api <method> <path> [json body]: prints the result, or explains the refusal
  local response
  response="$(curl -sS -m 60 -X "$1" "$CF_API$2" \
    --config <(printf 'header = "Authorization: Bearer %s"\n' "$CF_TOKEN") \
    -H 'Content-Type: application/json' ${3:+--data-binary "$3"})" \
    || { echo "Cloudflare could not be reached ($1 ${2%%\?*})" >&2; return 1; }
  if [[ "$(jq -r '.success // false' <<<"$response" 2>/dev/null)" != true ]]; then
    echo "Cloudflare refused $1 ${2%%\?*}: $(jq -r '[.errors[]? | "\(.code) \(.message)"] | join("; ")' <<<"$response" 2>/dev/null || echo 'unreadable answer')" >&2
    return 1
  fi
  jq -c '.result' <<<"$response"
}

read_cf_token() {
  local token
  token="$(ask_secret "Cloudflare API token (input hidden; needs Cloudflare Tunnel: Edit and DNS: Edit): ")" || return 1
  [[ $token =~ ^[A-Za-z0-9_-]{20,200}$ ]] || { echo "That does not look like a Cloudflare API token." >&2; return 1; }
  CF_TOKEN="$token"
}

domain_status() {
  if [[ ! -f $DOMAIN_STATE ]]; then
    echo "No domain is set up. Set one up with: claudeweb domain"
    return 0
  fi
  local host phase
  host="$(domain_get hostname)"; phase="$(domain_get phase)"
  if [[ $phase == ready ]]; then
    echo "Domain:    https://$host (tunnel $(systemctl is-active "$TUNNEL_SERVICE" 2>/dev/null || true))"
  else
    echo "Domain:    https://$host (setup not finished; continue with: claudeweb domain)"
  fi
}

# Deletes what this server created on Cloudflare: its DNS record (only while it
# still carries ClaudeWeb's comment) and its tunnel (found by name if its ID was
# never recorded). Needs CF_TOKEN.
domain_delete_remote() {
  local account zone host name tunnel record comment
  account="$(domain_get account_id)"; zone="$(domain_get zone_id)"
  host="$(domain_get hostname)"; name="$(domain_get tunnel_name)"
  comment="claudeweb-managed:$name"
  record="$(cf_api GET "/zones/$zone/dns_records?name=$host&per_page=100")" || return 1
  local id other
  while IFS=$'\t' read -r id other; do
    [[ -n $id ]] || continue
    if [[ $other != "$comment" ]]; then
      echo "The DNS record for $host was changed outside ClaudeWeb (its comment is not \"$comment\"); it was left alone." >&2
      continue
    fi
    cf_api DELETE "/zones/$zone/dns_records/$id" >/dev/null || return 1
    echo "Deleted the DNS record for $host."
  done < <(jq -r '.[] | [.id, (.comment // "")] | @tsv' <<<"$record")
  tunnel="$(domain_get tunnel_id)"
  if [[ -z $tunnel ]]; then
    tunnel="$(cf_api GET "/accounts/$account/cfd_tunnel?name=$name&is_deleted=false" | jq -r --arg n "$name" '[.[] | select(.name == $n)][0].id // empty')" || return 1
  fi
  if [[ -n $tunnel ]]; then
    cf_api DELETE "/accounts/$account/cfd_tunnel/$tunnel/connections" >/dev/null 2>&1 || true
    cf_api DELETE "/accounts/$account/cfd_tunnel/$tunnel" >/dev/null || return 1
    echo "Deleted the Cloudflare tunnel $name."
  fi
}

domain_forget_local() {
  systemctl disable --now "$TUNNEL_SERVICE" >/dev/null 2>&1 || true
  rm -f "$TUNNEL_UNIT" "$TUNNEL_TOKEN_FILE" "$DOMAIN_STATE"
  systemctl daemon-reload
}

install_cloudflared() {
  local version
  version="$( (/usr/bin/cloudflared --version 2>/dev/null || true) | sed -n 's/.*version \([0-9]*\.[0-9]*\.[0-9]*\).*/\1/p' | head -n1)"
  # --token-file needs cloudflared 2025.4.0 or newer.
  if [[ -n $version ]] && printf '%s\n%s\n' 2025.4.0 "$version" | sort -V -C; then
    return 0
  fi
  echo "Installing cloudflared from Cloudflare's signed package source..."
  local key
  key="$(mktemp)"
  curl -fsSL -m 60 -o "$key" "$CF_KEY_URL" || { rm -f "$key"; echo "cannot download $CF_KEY_URL" >&2; return 1; }
  # A changed key stops the setup: the published key must be checked by a person first.
  [[ "$(sha256sum "$key" | cut -d' ' -f1)" == "$CF_KEY_SHA256" ]] \
    || { rm -f "$key"; echo "Cloudflare's package signing key is not the expected one; nothing was installed." >&2; return 1; }
  install -m 0644 "$key" "$CF_KEYRING"
  rm -f "$key"
  echo "deb [arch=amd64 signed-by=$CF_KEYRING] https://pkg.cloudflare.com/cloudflared any main" > "$CF_SOURCE"
  apt-get -o DPkg::Lock::Timeout=180 update -q >/dev/null \
    && DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=180 install -y -q --no-install-recommends cloudflared >/dev/null \
    || { echo "cloudflared could not be installed" >&2; return 1; }
}

# Creates or picks up each part in order, recording it as it goes, so an
# interrupted setup continues where it stopped. Needs CF_TOKEN.
domain_provision() {
  local account zone host name tunnel dns token comment
  account="$(domain_get account_id)"; zone="$(domain_get zone_id)"
  host="$(domain_get hostname)"; name="$(domain_get tunnel_name)"
  comment="claudeweb-managed:$name"

  tunnel="$(domain_get tunnel_id)"
  if [[ -z $tunnel ]]; then
    tunnel="$(cf_api GET "/accounts/$account/cfd_tunnel?name=$name&is_deleted=false" | jq -r --arg n "$name" '[.[] | select(.name == $n)][0].id // empty')" || return 1
    if [[ -z $tunnel ]]; then
      tunnel="$(cf_api POST "/accounts/$account/cfd_tunnel" "$(jq -nc --arg n "$name" '{name: $n, config_src: "cloudflare"}')" | jq -r '.id // empty')" || return 1
    fi
    [[ $tunnel =~ ^[0-9a-f-]{36}$ ]] || { echo "Cloudflare did not return a tunnel ID" >&2; return 1; }
    domain_set tunnel_id "$tunnel" phase tunnel
    echo "Tunnel $name is ready."
  fi

  # Only this one name is routed, to ClaudeWeb on this server; anything else gets 404.
  cf_api PUT "/accounts/$account/cfd_tunnel/$tunnel/configurations" "$(jq -nc --arg h "$host" --arg s "http://127.0.0.1:$PORT" \
    '{config: {ingress: [{hostname: $h, service: $s}, {service: "http_status:404"}]}}')" >/dev/null || return 1

  dns="$(domain_get dns_id)"
  if [[ -z $dns ]]; then
    local existing
    existing="$(cf_api GET "/zones/$zone/dns_records?name=$host&per_page=100")" || return 1
    dns="$(jq -r --arg c "$comment" '[.[] | select(.comment == $c)][0].id // empty' <<<"$existing")"
    if [[ -z $dns ]]; then
      [[ "$(jq 'length' <<<"$existing")" == 0 ]] \
        || { echo "A DNS record for $host already exists and was not made by this server; it is left alone. Choose another name." >&2; return 1; }
      dns="$(cf_api POST "/zones/$zone/dns_records" "$(jq -nc --arg h "$host" --arg t "$tunnel.cfargotunnel.com" --arg c "$comment" \
        '{type: "CNAME", name: $h, content: $t, proxied: true, ttl: 1, comment: $c}')" | jq -r '.id // empty')" || return 1
    fi
    [[ -n $dns ]] || { echo "Cloudflare did not return the DNS record" >&2; return 1; }
    domain_set dns_id "$dns" phase dns
    echo "DNS record for $host is ready."
  fi

  token="$(cf_api GET "/accounts/$account/cfd_tunnel/$tunnel/token" | jq -r '. // empty')" || return 1
  [[ -n $token ]] || { echo "Cloudflare did not return the tunnel's run token" >&2; return 1; }
  (umask 077; printf '%s' "$token" > "$TUNNEL_TOKEN_FILE.new")
  mv -f "$TUNNEL_TOKEN_FILE.new" "$TUNNEL_TOKEN_FILE"
  token=""
  CF_TOKEN=""   # nothing below talks to the Cloudflare API
  domain_set phase token

  install_cloudflared || return 1
  install -m 0644 "$CURRENT/share/claudeweb-tunnel.service" "$TUNNEL_UNIT"
  systemctl daemon-reload
  systemctl enable "$TUNNEL_SERVICE" >/dev/null 2>&1
  systemctl restart "$TUNNEL_SERVICE"
  domain_set phase running
  domain_check
}

# Ready only when cloudflared is connected, the name answers over HTTPS and an
# API that needs a login refuses a visitor without one.
domain_check() {
  local host probe status
  host="$(domain_get hostname)"
  probe="${CLAUDEWEB_DOMAIN_PROBE:-https://$host}"   # tests reach ClaudeWeb directly
  echo "Waiting for the tunnel to connect..."
  for _ in $(seq 1 60); do
    curl -fsS -m 3 http://127.0.0.1:20241/ready >/dev/null 2>&1 && break
    sleep 1
  done
  curl -fsS -m 3 http://127.0.0.1:20241/ready >/dev/null 2>&1 \
    || { echo "cloudflared did not connect to Cloudflare; see: journalctl -u $TUNNEL_SERVICE. Outbound port 7844 must be open." >&2; return 1; }
  echo "Waiting for https://$host to answer (new DNS names can take a few minutes)..."
  for _ in $(seq 1 36); do
    curl -fsS -m 10 -H "Host: $host" "$probe/api/auth/status" >/dev/null 2>&1 && break
    sleep 5
  done
  curl -fsS -m 10 -H "Host: $host" "$probe/api/auth/status" >/dev/null 2>&1 \
    || { echo "The tunnel is connected, but https://$host does not answer yet. Check again later with: claudeweb domain" >&2; return 1; }
  status="$(curl -s -o /dev/null -w '%{http_code}' -m 10 -H "Host: $host" "$probe/api/auth/devices")"
  [[ $status == 401 ]] || { echo "https://$host answered a request without a login with $status instead of 401; the domain is not marked ready." >&2; return 1; }
  domain_set phase ready
  echo "Domain ready: https://$host"
}

domain_new() {
  local domain again host label account zone zone_info
  domain="$(ask "Domain managed in Cloudflare (for example example.com): ")" || return 1
  domain="${domain,,}"
  again="$(ask "Type the domain again: ")" || return 1
  [[ $domain == "${again,,}" ]] || { echo "The two entries differ." >&2; return 1; }
  [[ $domain =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]] || { echo "\"$domain\" is not a domain name." >&2; return 1; }
  if ask_yes "Use a random name under $domain? [Y/n] " y; then
    label="$(head -c 10 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    host="$label.$domain"
  else
    host="$(ask "Full name, one level under $domain (for example claude.$domain): ")" || return 1
    host="${host,,}"
    label="${host%%.*}"
    # Cloudflare's free certificate covers one level under the domain.
    [[ $host == "$label.$domain" && $label =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] \
      || { echo "The name must be exactly one level under $domain, like claude.$domain." >&2; return 1; }
  fi
  account="$(ask "Cloudflare Account ID: ")" || return 1
  [[ $account =~ ^[0-9a-f]{32}$ ]] || { echo "An Account ID is 32 characters of 0-9 and a-f." >&2; return 1; }
  zone="$(ask "Zone ID of $domain: ")" || return 1
  [[ $zone =~ ^[0-9a-f]{32}$ ]] || { echo "A Zone ID is 32 characters of 0-9 and a-f." >&2; return 1; }
  read_cf_token || return 1
  zone_info="$(cf_api GET "/zones/$zone")" || return 1
  [[ "$(jq -r '.name' <<<"$zone_info")" == "$domain" ]] || { echo "Zone $zone is $(jq -r '.name' <<<"$zone_info"), not $domain." >&2; return 1; }
  [[ "$(jq -r '.status' <<<"$zone_info")" == active ]] || { echo "$domain is not active in Cloudflare yet." >&2; return 1; }
  # Checked before anything is created, so a taken name leaves nothing behind.
  local taken
  taken="$(cf_api GET "/zones/$zone/dns_records?name=$host&per_page=100")" || return 1
  [[ "$(jq 'length' <<<"$taken")" == 0 ]] || { echo "A DNS record for $host already exists; it is left alone. Choose another name." >&2; return 1; }
  local machine
  machine="$(head -c 8 /etc/machine-id 2>/dev/null || echo server)"
  domain_set schema 1 hostname "$host" domain "$domain" account_id "$account" zone_id "$zone" \
    tunnel_name "claudeweb-$machine-$(head -c 3 /dev/urandom | od -An -tx1 | tr -d ' \n')" phase start
}

domain_setup() {  # domain_setup [ask]: with ask, first asks whether to set one up (Enter = no)
  domain_tty || die "setting up a domain needs a terminal; run: claudeweb domain"
  trap 'echo; echo "Domain setup stopped. ClaudeWeb works without it; set it up later with: claudeweb domain"; exit 130' INT
  if [[ -f $DOMAIN_STATE && "$(domain_get phase)" == ready ]]; then
    echo "A domain is already set up: https://$(domain_get hostname)"
    echo "To use another one, first run: claudeweb domain --remove"
    return 0
  fi
  if [[ ${1:-} == ask && ! -f $DOMAIN_STATE ]]; then
    echo "A domain lets phones, tablets and other computers open ClaudeWeb over HTTPS"
    echo "through a Cloudflare Tunnel (no port is opened on this server). It needs a domain"
    echo "managed in Cloudflare. You can also do this later with: claudeweb domain"
    ask_yes "Set up a domain now? [y/N] " n || { echo "No domain set up."; return 0; }
  fi
  if [[ -f $DOMAIN_STATE ]]; then
    local phase host
    phase="$(domain_get phase)"; host="$(domain_get hostname)"
    if [[ $phase == running ]]; then
      domain_check
      return
    fi
    if ask_yes "An unfinished domain setup for $host was found. Continue it? [Y/n] " y; then
      read_cf_token || return 1
      domain_provision
      return
    fi
    echo "Removing what the unfinished setup created on Cloudflare..."
    read_cf_token || return 1
    domain_delete_remote || return 1
    domain_forget_local
  fi
  domain_new || return 1
  domain_provision
}

domain_remove() {
  [[ -f $DOMAIN_STATE ]] || { echo "No domain is set up."; return 0; }
  local host name
  host="$(domain_get hostname)"; name="$(domain_get tunnel_name)"
  if [[ ${1:-} == --local ]]; then
    domain_forget_local
    echo "The tunnel on this server was stopped and forgotten. In Cloudflare, delete the tunnel"
    echo "$name and the DNS record $host yourself."
    return 0
  fi
  domain_tty || die "removing the domain needs a terminal (or use: claudeweb domain --remove --local)"
  echo "This deletes the DNS record $host and the tunnel $name in Cloudflare,"
  echo "and stops the tunnel on this server. ClaudeWeb keeps running on 127.0.0.1:$PORT."
  read_cf_token || return 1
  systemctl stop "$TUNNEL_SERVICE" >/dev/null 2>&1 || true
  domain_delete_remote || { echo "Nothing more was changed; fix the problem and run claudeweb domain --remove again." >&2; return 1; }
  domain_forget_local
  echo "The domain was removed."
}

cmd_domain() {
  need_root domain
  case "${1:-}" in
    "") domain_setup ;;
    --ask) domain_setup ask ;;
    --status) domain_status ;;
    --remove) domain_remove "${2:-}" ;;
    *) die "usage: claudeweb domain [--status | --remove [--local]]" ;;
  esac
}

# ------------------------------------------------------------------ uninstall
cmd_uninstall() {
  need_root uninstall
  local delete_projects=0
  case "${1:-}" in
    "") ;;
    --delete-projects) delete_projects=1 ;;
    *) die "usage: claudeweb uninstall [--delete-projects]" ;;
  esac

  echo "This removes ClaudeWeb from this server:"
  echo "  program, settings and login password: $OPT_DIR, $ETC_DIR"
  echo "  data, chats and Claude's login:       $DATA_DIR, $SERVICE_HOME (except projects)"
  echo "  the service, the claudeweb user, ClaudeWeb's swap file"
  if [[ -f $DOMAIN_STATE ]]; then
    echo "  the tunnel to $(domain_get hostname) on this server. Its tunnel and DNS record in"
    echo "  Cloudflare stay; to delete them too, first run: claudeweb domain --remove"
  fi
  if (( delete_projects )); then
    echo "  YOUR PROJECTS WILL BE DELETED:        $PROJECTS_DIR"
  else
    echo "Your projects are kept in $PROJECTS_DIR."
  fi
  local answer
  read -r -p "Uninstall ClaudeWeb? [y/n] " answer
  [[ $answer == y || $answer == Y ]] || { echo "Stopped; nothing was changed."; return 0; }

  [[ -f $DOMAIN_STATE ]] && domain_forget_local
  systemctl disable --now "$SERVICE" claudeweb-update.socket 2>/dev/null || true
  rm -f "$UNIT_FILE" /etc/systemd/system/claudeweb-update.socket /etc/systemd/system/claudeweb-update@.service
  systemctl daemon-reload
  swap_remove
  rm -f "$IPV6_SYSCTL"   # IPv6 stays off until the next reboot; it is not turned back on here.
  if [[ -f $SSHD_DROPIN ]]; then rm -f "$SSHD_DROPIN"; systemctl reload ssh >/dev/null 2>&1 || true; fi
  pkill -u "$SERVICE_USER" 2>/dev/null || true
  sleep 1
  pkill -KILL -u "$SERVICE_USER" 2>/dev/null || true
  if (( delete_projects )); then
    rm -rf "$SERVICE_HOME"
  elif [[ -d $SERVICE_HOME ]]; then
    find "$SERVICE_HOME" -mindepth 1 -maxdepth 1 ! -name projects -exec rm -rf {} +
  fi
  userdel "$SERVICE_USER" 2>/dev/null || true
  rm -rf "$ETC_DIR" "$DATA_DIR" "$LOG_DIR" "$UPDATE_DIR"
  rm -f /usr/local/bin/claudeweb
  rm -rf "$OPT_DIR"
  if (( delete_projects )); then
    echo "ClaudeWeb and its projects were removed."
  else
    echo "ClaudeWeb was removed. Projects remain in $PROJECTS_DIR (owned by the old claudeweb user id)."
  fi
}

# ------------------------------------------------------------------ main
command="${1:-help}"
[[ $# -gt 0 ]] && shift
case "$command" in
  help|-h|--help) show_help ;;
  status) cmd_status "$@" ;;
  logs) cmd_logs "$@" ;;
  doctor) cmd_doctor "$@" ;;
  password) cmd_password "$@" ;;
  sudo-password) cmd_sudo_password "$@" ;;
  swap) cmd_swap "$@" ;;
  update) cmd_update "$@" ;;
  rollback) cmd_rollback "$@" ;;
  serve-update) cmd_serve_update "$@" ;;
  install-browser) cmd_install_browser "$@" ;;
  install-desktop) cmd_install_desktop "$@" ;;
  domain) cmd_domain "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  *) echo "Unknown command: $command" >&2; echo >&2; show_help >&2; exit 1 ;;
esac
