[Unit]
Description=ClaudeWeb update request (one connection, then exit)

[Service]
Type=simple
User=root
Group=root
StandardInput=socket
StandardOutput=socket
StandardError=journal
# Only `check` and `update` to a newer stable release; the update itself runs
# as a separate job (systemd-run), so this connection ends at once.
ExecStart=/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 /opt/claudeweb/current/bin/claudeweb serve-update
RuntimeMaxSec=90
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
LimitCORE=0
